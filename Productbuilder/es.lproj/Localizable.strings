"help.product.resources" = "Recursos: carpeta opcional de recursos del instalador para archivos referenciados por distribution.xml.";
"help.product.signing" = "Firma: identidad Developer ID Installer usada para firmar el paquete de producto final.";
"help.product.notarization" = "Notarización: notarización opcional de Apple mediante xcrun notarytool con un perfil guardado en el llavero. Solo se ejecuta después de firmar y después adjunta el ticket al .pkg.";
