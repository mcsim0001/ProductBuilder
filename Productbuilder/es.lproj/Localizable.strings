"help.window.title" = "Ayuda de Productbuilder";
"help.window.subtitle" = "Guía práctica de la app y de sus opciones para crear instaladores.";
"help.overview.title" = "Qué hace Productbuilder";
"help.overview.body" = "Productbuilder crea instaladores macOS product .pkg. Puede crear paquetes de componentes, combinarlos en un paquete de producto, importar proyectos Packages .pkgproj, configurar archivos y carpetas de payload, generar recursos de instalador, previsualizar páginas, firmar y notarizar paquetes y crear un script de desinstalación.";
"help.overview.workflow" = "Flujo típico: añade componentes, define el payload, configura metadatos del producto, añade páginas y localizaciones, previsualiza, elige firma y notarización opcional y crea el .pkg final.";
"help.about" = "Acerca de %@";
"help.product.name" = "Nombre: nombre visible del producto final del instalador.";
"help.product.identifier" = "Identificador: id reverse-DNS del producto usado por los recibos de macOS Installer.";
"help.product.version" = "Versión: versión del producto escrita en el paquete generado.";
