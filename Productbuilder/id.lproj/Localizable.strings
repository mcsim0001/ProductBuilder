"help.window.subtitle" = "Panduan praktis untuk aplikasi dan opsi pembuatan installer.";
"help.overview.title" = "Apa yang dilakukan Productbuilder";
"help.overview.body" = "Productbuilder membuat installer macOS product .pkg. Aplikasi ini dapat membuat paket komponen, menggabungkannya menjadi paket produk, mengimpor proyek Packages .pkgproj, mengatur file/folder payload, membuat resource installer, mempratinjau halaman, menandatangani dan menotarisasi paket, serta membuat script uninstall.";
"help.overview.workflow" = "Workflow umum: tambah komponen, definisikan payload, atur metadata produk, tambah halaman dan lokalisasi installer, pratinjau, pilih signing dan notarisasi opsional, lalu build .pkg final.";
"help.about" = "Tentang %@";
