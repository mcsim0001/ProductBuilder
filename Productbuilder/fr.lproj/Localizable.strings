"about.credits" = "Outil macOS dédié à la création d’installateurs product .pkg à partir de composants, charges utiles, ressources d’installateur, pages localisées, réglages de signature et notarisation, et scripts de désinstallation optionnels.";
"help.window.title" = "Aide Productbuilder";
"help.window.subtitle" = "Guide pratique de l’app et de ses options de création d’installateur.";
"help.overview.title" = "Ce que fait Productbuilder";
"help.overview.body" = "Productbuilder crée des installateurs macOS product .pkg. Il peut générer des paquets de composants, les combiner en paquet produit, importer des projets Packages .pkgproj, configurer fichiers et dossiers de charge utile, générer les ressources d’installateur, prévisualiser les pages, signer et notariser les paquets, et créer un script de désinstallation.";
"help.overview.workflow" = "Flux typique : ajoutez des composants, définissez le payload, configurez les métadonnées produit, ajoutez pages et localisations, prévisualisez, choisissez signature et notarisation optionnelle, puis générez le .pkg final.";
"help.about" = "À propos de %@";
"help.product.name" = "Nom : display name of the final installer product.";
"help.product.identifier" = "Identifiant : reverse-DNS product id used by macOS Installer receipts.";
"help.product.version" = "Version : product version written into the generated package.";
"help.product.fileName" = "File Nom : final .pkg file name. It is generated from the product name and version until you edit it manually.";
"help.product.output" = "Sortie : folder where the final .pkg and optional uninstaller are created.";
"help.product.openOutputAfterBuild" = "Ouvrir après la compilation : révèle le .pkg généré dans Finder lorsque la compilation réussit.";
"help.product.resources" = "Ressources : optional installer resources folder for files referenced by distribution.xml.";
"help.product.signing" = "Signature : Developer ID Installer identity used to sign the final product package.";
"help.product.notarization" = "Notarisation : optional Apple notarization using xcrun notarytool with a stored keychain profile. It only runs after signing, then staples the notarization ticket to the .pkg.";
"help.design.logo" = "Icône du paquet : image optionnelle appliquée au fichier .pkg final et affichée dans la barre de titre d’Installer.";
"help.design.background" = "Arrière-plan et arrière-plan sombre : images utilisées derrière la fenêtre d’Installer. Si l’arrière-plan sombre est vide, l’arrière-plan normal est utilisé pour les deux apparences.";
"help.design.scaling" = "Mise à l’échelle et alignement : placement de l’image d’arrière-plan dans la fenêtre d’Installer.";
"help.design.pages" = "Bienvenue, Read Me, Licence, Conclusion : pages de l’installateur copiées dans le dossier de ressources et référencées depuis distribution.xml.";
"help.design.localizations" = "Localisations : language-specific variants of each page, written into .lproj folders.";
"help.rules.minimum" = "macOS minimum : optional version requirement for the installer.";
"help.rules.customize" = "Personnaliser : allows the user to choose visible optional components in Installer.";
"help.rules.localSystem" = "Système local : enables installing for the whole Mac, usually the normal mode for /Applications and /Library payloads.";
"help.rules.currentUserHome" = "Dossier utilisateur courant : enables per-user installation into the selected user's home domain.";
"help.rules.anywhere" = "N’importe où : allows selecting another destination volume or path when Installer supports it.";
"help.uninstaller.generate" = "Générer un script shell de désinstallation : crée un script compagnon à côté du .pkg final.";
"help.uninstaller.removes" = "Le script supprime les fichiers installés que Productbuilder peut suivre en toute sécurité pendant la compilation.";
