"about.credits" = "Ein fokussiertes macOS-Werkzeug zum Erstellen von product .pkg-Installern aus Komponenten, Nutzlasten, Installer-Ressourcen, lokalisierten Seiten, Signierung, Notarisierung und optionalen Deinstallationsskripten.";
"help.window.title" = "Productbuilder-Hilfe";
"help.window.subtitle" = "Praktische Anleitung zur App und ihren Installer-Erstellungsoptionen.";
"help.overview.title" = "Was Productbuilder macht";
"help.overview.body" = "Productbuilder erstellt macOS-product-.pkg-Installer. Es kann Komponentenpakete bauen, sie zu einem Produktpaket kombinieren, Packages-.pkgproj-Projekte importieren, Nutzlastdateien und -ordner konfigurieren, Installer-Ressourcen erzeugen, Seiten vorschauen, Pakete signieren und notarisieren sowie ein Deinstallationsskript erstellen.";
"help.overview.workflow" = "Typischer Ablauf: Komponenten hinzufügen, Nutzlast definieren, Produktmetadaten konfigurieren, Installer-Seiten und Lokalisierungen hinzufügen, Vorschau prüfen, Signierung und optionale Notarisierung wählen, dann das finale .pkg bauen.";
"help.about" = "Über %@";
"help.product.name" = "Name: Anzeigename des endgültigen Installer-Produkts.";
"help.product.identifier" = "Kennung: reverse-DNS product id used by macOS Installer receipts.";
"help.product.version" = "Version: Produktversion, die in das erzeugte Paket geschrieben wird.";
"help.product.fileName" = "Dateiname: final .pkg file name. It is generated from the product name and version until you edit it manually.";
"help.product.output" = "Ausgabe: folder where the final .pkg and optional uninstaller are created.";
"help.product.openOutputAfterBuild" = "Nach dem Build öffnen: zeigt das erzeugte .pkg im Finder, wenn der Build erfolgreich war.";
"help.product.resources" = "Ressourcen: optional installer resources folder for files referenced by distribution.xml.";
"help.product.signing" = "Signierung: Developer ID Installer identity used to sign the final product package.";
"help.product.notarization" = "Notarisierung: optional Apple notarization using xcrun notarytool with a stored keychain profile. It only runs after signing, then staples the notarization ticket to the .pkg.";
"help.design.logo" = "Paket-Icon: optionales Bild für die endgültige .pkg-Datei und die Titelleiste von Installer.";
"help.design.background" = "Hintergrund und dunkler Hintergrund: Bilder hinter dem Installer-Fenster. Wenn der dunkle Hintergrund leer ist, wird der normale Hintergrund für beide Erscheinungsbilder verwendet.";
"help.design.scaling" = "Skalierung und Ausrichtung: legt fest, wie das Hintergrundbild im Installer-Fenster platziert wird.";
"help.design.pages" = "Willkommen, Read Me, Lizenz, Abschluss: Installer-Seiten, die in den Ressourcenordner kopiert und in distribution.xml referenziert werden.";
"help.design.localizations" = "Lokalisierungen: language-specific variants of each page, written into .lproj folders.";
"help.rules.minimum" = "Minimales macOS: optional version requirement for the installer.";
"help.rules.customize" = "Anpassen: allows the user to choose visible optional components in Installer.";
"help.rules.localSystem" = "Lokales System: enables installing for the whole Mac, usually the normal mode for /Applications and /Library payloads.";
"help.rules.currentUserHome" = "Home des aktuellen Benutzers: enables per-user installation into the selected user's home domain.";
"help.rules.anywhere" = "Überall: allows selecting another destination volume or path when Installer supports it.";
"help.uninstaller.generate" = "Deinstallations-Shell-Skript erzeugen: erstellt ein Begleitskript neben dem endgültigen .pkg.";
"help.uninstaller.removes" = "Das Skript entfernt installierte Payload-Dateien, die Productbuilder während des Builds sicher verfolgen kann.";
"help.uninstaller.emptyDirs" = "Leere Verzeichniseinträge werden vom Installer erstellt, aber vom erzeugten Skript nicht aggressiv entfernt.";
"help.ownership.short" = "Empfohlen lässt pkgbuild die Standard-Eigentümerschaft des Installers anwenden. Beibehalten erhält die Eigentümerschaft der Quelldateien.";
"help.choice.required" = "Der Benutzer kann diese Komponente in Installer nicht abwählen. Erforderliche Komponenten sind immer ausgewählt.";
"help.choice.selected" = "Die Komponente ist ausgewählt, wenn Installer die Anpassen-Liste öffnet.";
"help.choice.visible" = "Zeigt diese Komponente in der Anpassen-Liste von Installer.";
"help.component.name" = "Name: Bezeichnung dieser Komponente in Productbuilder und in den Auswahloptionen von Installer.";
"help.component.identifier" = "Kennung: reverse-DNS id for this component package receipt.";
"help.component.version" = "Version: Komponentenpaket-Version, die an pkgbuild übergeben wird.";
"help.component.ownership" = "Eigentümerschaft: Empfohlen lässt pkgbuild die Standard-Eigentümerschaft anwenden; Beibehalten erhält die Eigentümerschaft der Quelldateien.";
"help.component.choice" = "Auswahl: steuert, ob die Komponente erforderlich, standardmäßig ausgewählt und in Installer Anpassen sichtbar ist.";
"help.component.scripts" = "Preinstall und Postinstall: optionale Shell-Skripte, die von diesem Komponentenpaket ausgeführt werden.";
