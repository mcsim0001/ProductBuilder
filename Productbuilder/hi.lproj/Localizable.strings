"help.window.subtitle" = "ऐप और उसके installer बनाने के विकल्पों की व्यावहारिक मार्गदर्शिका।";
"help.overview.title" = "Productbuilder क्या करता है";
"help.overview.body" = "Productbuilder macOS product .pkg installers बनाता है। यह component packages बना सकता है, उन्हें product package में जोड़ सकता है, Packages .pkgproj आयात कर सकता है, payload files/folders कॉन्फ़िगर कर सकता है, installer resources बना सकता है, pages preview कर सकता है, packages sign/notarize कर सकता है और uninstall script बना सकता है।";
"help.overview.workflow" = "सामान्य workflow: components जोड़ें, payload परिभाषित करें, product metadata सेट करें, installer pages/localizations जोड़ें, preview करें, signing और optional notarization चुनें, फिर final .pkg build करें।";
"help.about" = "%@ के बारे में";
"help.product.name" = "नाम: अंतिम installer product का दिखने वाला नाम।";
"help.product.identifier" = "पहचानकर्ता: macOS Installer receipts में उपयोग होने वाला reverse-DNS product id।";
"help.product.version" = "संस्करण: generated package में लिखा जाने वाला product version।";
"help.product.fileName" = "फ़ाइल नाम: अंतिम .pkg file name। जब तक आप इसे manually edit नहीं करते, यह product name और version से generate होता है।";
"help.product.output" = "आउटपुट: वह folder जहाँ final .pkg और optional uninstaller बनाए जाते हैं।";
"help.product.openOutputAfterBuild" = "Build पूरा होने पर खोलें: build सफल होने पर generated .pkg को Finder में दिखाएँ।";
"help.product.resources" = "संसाधन: distribution.xml में referenced files के लिए optional installer resources folder।";
"help.product.signing" = "Signing: final product package को sign करने के लिए Developer ID Installer identity।";
"help.product.notarization" = "Notarization: stored keychain profile के साथ xcrun notarytool द्वारा optional Apple notarization। यह signing के बाद ही चलता है और फिर notarization ticket को .pkg से जोड़ता है।";
"help.design.logo" = "Package Icon: final .pkg file पर लगाई जाने वाली और Installer title bar में दिखने वाली optional image।";
"help.design.background" = "Background और Dark Background: Installer window के पीछे इस्तेमाल होने वाली images। Dark Background खाली हो तो Background दोनों appearances में इस्तेमाल होता है।";
"help.design.scaling" = "Scaling और Alignment: background image को Installer window में कैसे रखा जाए।";
"help.design.pages" = "Welcome, Read Me, License, Conclusion: installer pages जिन्हें resources folder में copy करके distribution.xml से reference किया जाता है।";
"help.design.localizations" = "Localizations: हर page के language-specific variants, जो .lproj folders में लिखे जाते हैं।";
"help.rules.minimum" = "Minimum macOS: installer के लिए optional version requirement।";
"help.rules.customize" = "Customize: user को Installer में visible optional components चुनने देता है।";
"help.rules.localSystem" = "Local system: पूरे Mac के लिए installation सक्षम करता है; /Applications और /Library payloads के लिए सामान्य mode।";
"help.rules.currentUserHome" = "Current user home: selected user के home domain में per-user installation सक्षम करता है।";
"help.rules.anywhere" = "Anywhere: Installer support होने पर दूसरा destination volume या path चुनने देता है।";
"help.uninstaller.generate" = "Uninstall shell script generate करें: final .pkg के पास companion script बनाता है।";
"help.uninstaller.removes" = "Script उन installed payload files को हटाता है जिन्हें Productbuilder build के दौरान safely track कर सकता है।";
"help.uninstaller.emptyDirs" = "Empty directory entries installer बनाता है, लेकिन generated script उन्हें aggressively remove नहीं करता।";
"help.ownership.short" = "Recommended pkgbuild को standard installer ownership लागू करने देता है। Preserve source files की ownership रखता है।";
"help.choice.required" = "User इस component को Installer में deselect नहीं कर सकता। Required components हमेशा selected रहते हैं।";
"help.choice.selected" = "Installer की Customize list खुलते समय component selected रहता है।";
"help.choice.visible" = "इस component को Installer की Customize list में दिखाएँ।";
"help.component.name" = "नाम: Productbuilder और Installer choices में इस component का label।";
"help.component.identifier" = "पहचानकर्ता: इस component package receipt का reverse-DNS id।";
"help.component.version" = "संस्करण: pkgbuild को दिया जाने वाला component package version।";
"help.component.ownership" = "Ownership: Recommended pkgbuild को standard ownership लागू करने देता है; Preserve source ownership रखता है।";
"help.component.choice" = "Choice: component required है या नहीं, default selected है या नहीं, और Installer Customize में visible है या नहीं, इसे नियंत्रित करता है।";
"help.component.scripts" = "Preinstall और Postinstall: इस component package द्वारा चलाए जाने वाले optional shell scripts।";
"help.component.mustCloseApplications" = "बंद करने वाले ऐप्स: चल रहे ऐप्स के बंडल पहचानकर्ता जिन्हें macOS Installer इस component को install करने से पहले बंद कराएगा। Installer मूल confirmation dialog दिखाता है।";
"help.preview.page" = "पृष्ठ: पूर्वावलोकन करने के लिए Installer पृष्ठ चुनता है।";
"help.preview.localization" = "स्थानीयकरण: डिफ़ॉल्ट संसाधन या स्थानीयकृत .lproj variant दिखाता है।";
"help.preview.appearance" = "रूप: हल्के और गहरे background विकल्पों के बीच बदलता है।";
"help.preview.approximate" = "पूर्वावलोकन अनुमानित है; अंतिम लेआउट अभी भी macOS Installer द्वारा रेंडर किया जाता है।";
"help.payload.fileFolder" = "File/Folder: selected file या folder को destination में copy करता है।";
"help.payload.folderContents" = "Folder Contents: build time पर source folder की current contents को fixed destination folder में copy करता है।";
"help.payload.emptyDirectory" = "Empty Directory: source path के बिना destination folder बनाता है।";
"help.payload.destination" = "Destination: absolute install path जहाँ यह payload entry staged होगी।";
"help.payload.permissions" = "Permissions: जब payload entry को Packages की तरह Bom/Payload में owner, group और POSIX modes साफ़-साफ़ लिखने हों, तब इसे चालू करें।";
"help.payload.permissions.principals" = "Owner/Group: installer-owned items के लिए root; admin tools द्वारा writable app support folders के लिए admin; सामान्य system paths के लिए wheel; shared user resources के लिए staff।";
"help.payload.permissions.modes" = "Modes: 755 read/traverse और execute देता है; 775 group को write भी देता है; 644 सामान्य read-only files के लिए है।";
"help.payload.permissions.bundle" = "Bundles: .app/.systemextension entries में Bundle mode केवल bundle root पर लागू होता है; अंदर की files source permissions और code signatures रखती हैं।";
