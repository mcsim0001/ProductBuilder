"about.credits" = "Ferramenta focada para macOS que cria instaladores product .pkg a partir de componentes, entradas de payload, recursos do instalador, páginas localizadas, assinatura, notarização e scripts opcionais de desinstalação.";
"help.window.title" = "Ajuda do Productbuilder";
"help.window.subtitle" = "Guia prático da aplicação e das opções para criar instaladores.";
"help.overview.title" = "O que o Productbuilder faz";
"help.overview.body" = "O Productbuilder cria instaladores macOS product .pkg. Ele cria pacotes de componentes, combina-os em um pacote de produto, importa projetos Packages .pkgproj, configura arquivos e pastas de payload, gera recursos do instalador, pré-visualiza páginas, assina e notariza pacotes e cria script de desinstalação.";
"help.overview.workflow" = "Fluxo típico: adicione componentes, defina payloads, configure metadados do produto, adicione páginas e localizações, visualize, escolha assinatura e notarização opcional e gere o .pkg final.";
"help.about" = "Sobre %@";
"help.product.name" = "Nome: display name of the final installer product.";
"help.product.identifier" = "Identificador: reverse-DNS product id used by macOS Installer receipts.";
"help.product.version" = "Versão: product version written into the generated package.";
"help.product.fileName" = "File Nome: final .pkg file name. It is generated from the product name and version until you edit it manually.";
"help.product.output" = "Saída: folder where the final .pkg and optional uninstaller are created.";
"help.product.openOutputAfterBuild" = "Abrir após o build: revela o .pkg gerado no Finder quando o build é concluído com sucesso.";
"help.product.resources" = "Recursos: optional installer resources folder for files referenced by distribution.xml.";
"help.product.signing" = "Assinatura: Developer ID Installer identity used to sign the final product package.";
"help.product.notarization" = "Notarização: optional Apple notarization using xcrun notarytool with a stored keychain profile. It only runs after signing, then staples the notarization ticket to the .pkg.";
"help.design.logo" = "Ícone do pacote: imagem opcional aplicada ao arquivo .pkg final e exibida na barra de título do Installer.";
"help.design.background" = "Plano de fundo e plano de fundo escuro: imagens usadas atrás da janela do Installer. Se o plano de fundo escuro estiver vazio, o plano de fundo normal será usado nos dois modos.";
"help.design.scaling" = "Escala e alinhamento: como a imagem de fundo é posicionada na janela do Installer.";
"help.design.pages" = "Boas-vindas, Read Me, Licença e Conclusão: páginas do instalador copiadas para a pasta de recursos e referenciadas em distribution.xml.";
"help.design.localizations" = "Localizações: language-specific variants of each page, written into .lproj folders.";
"help.rules.minimum" = "macOS mínimo: optional version requirement for the installer.";
"help.rules.customize" = "Personalizar: allows the user to choose visible optional components in Installer.";
"help.rules.localSystem" = "Sistema local: enables installing for the whole Mac, usually the normal mode for /Applications and /Library payloads.";
"help.rules.currentUserHome" = "Home do usuário atual: enables per-user installation into the selected user's home domain.";
"help.rules.anywhere" = "Qualquer lugar: allows selecting another destination volume or path when Installer supports it.";
"help.uninstaller.generate" = "Gerar script shell de desinstalação: cria um script auxiliar ao lado do .pkg final.";
"help.uninstaller.removes" = "O script remove arquivos instalados que o Productbuilder consegue rastrear com segurança durante o build.";
"help.uninstaller.emptyDirs" = "Entradas de diretórios vazios são criadas pelo instalador, mas não são removidas agressivamente pelo script gerado.";
